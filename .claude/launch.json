{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "staging",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev:staging"],
      "port": 8085
    },
    {
      "name": "production",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--", "--port", "8082", "--strictPort"],
      "port": 8082
    },
    {
      "name": "mobile-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "apps/mobile", "run", "web:clean", "--", "--port", "8086"],
      "port": 8086
    }
  ]
}
