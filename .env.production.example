# ============================================
# PRODUCTION ENVIRONMENT VARIABLES
# ============================================
# NO COMITEAR - Solo para referencia

# Supabase Production
VITE_SUPABASE_URL=https://YOUR_PROD_PROJECT_ID.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PROD_ANON_KEY

# Environment
VITE_ENV=production

# Feature Flags
VITE_ENABLE_RATE_LIMITING=true
VITE_ENABLE_OFFLINE_SYNC=true
VITE_ENABLE_ERROR_BOUNDARIES=true

# Analytics
VITE_SENTRY_DSN=https://YOUR_PROD_SENTRY_DSN@sentry.io/PROJECT_ID
VITE_POSTHOG_KEY=phc_YOUR_PROD_KEY
VITE_POSTHOG_HOST=https://app.posthog.com

# Vercel Analytics
VITE_VERCEL_ANALYTICS_ID=

# Performance
VITE_BUNDLE_ANALYZE=false
VITE_DEBUG_MODE=false
VITE_SOURCE_MAPS=false

# NO staging banner
VITE_SHOW_STAGING_BANNER=false
