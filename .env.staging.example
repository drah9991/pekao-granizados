# ============================================
# STAGING ENVIRONMENT VARIABLES
# ============================================
# Copia este archivo a .env.staging y completa los valores

# Supabase Staging Project
VITE_SUPABASE_URL=https://YOUR_STAGING_PROJECT_ID.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_STAGING_ANON_KEY

# Environment
VITE_ENV=staging

# Feature Flags (Phase 1)
VITE_ENABLE_RATE_LIMITING=true
VITE_ENABLE_OFFLINE_SYNC=true
VITE_ENABLE_ERROR_BOUNDARIES=true

# Analytics (usar proyectos staging separados)
VITE_SENTRY_DSN=https://YOUR_STAGING_SENTRY_DSN@sentry.io/PROJECT_ID
VITE_POSTHOG_KEY=phc_YOUR_STAGING_KEY
VITE_POSTHOG_HOST=https://app.posthog.com

# Vercel Analytics (opcional)
VITE_VERCEL_ANALYTICS_ID=

# Testing
VITE_E2E_BASE_URL=http://localhost:5173
TEST_EMAIL=admin@staging.test
TEST_PASSWORD=StrongPassword123!@#

# Performance
VITE_BUNDLE_ANALYZE=false
VITE_DEBUG_MODE=true
VITE_SOURCE_MAPS=true

# Database Connection (for migrations)
# STAGING_DB_URL=postgresql://postgres:PASSWORD@db.PROJECT_ID.supabase.co:5432/postgres

# Opcional: Staging Banner
VITE_SHOW_STAGING_BANNER=true
VITE_STAGING_MESSAGE=Entorno de Pruebas - No usar en producción
