# Variables de entorno - pekao-agent
# Copia este archivo a .env y completa los valores

# ─── Supabase (Backend) ───────────────────────────────────────
# Estas las encuentras en: supabase.com → proyecto → Settings → API
SUPABASE_URL="https://xxxxxxxxxxx.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# ─── Modelo de IA ─────────────────────────────────────────────
# Clave de OpenAI para el agente (modelo gpt-4o-mini recomendado)
OPENAI_API_KEY="sk-..."

# ─── Notificaciones vía Make.com ─────────────────────────────
# URL del Custom Webhook de Make.com.
# Cómo obtenerla:
#   1. make.com → Crear escenario
#   2. Agregar módulo: Webhooks > Custom webhook
#   3. Copiar la URL generada (ej: https://hook.eu2.make.com/abc123xyz)
# Make.com enruta el payload a WhatsApp Business, Telegram, Email, etc.
NOTIFY_WEBHOOK_URL="https://hook.eu2.make.com/xxxxxxxxxxxxxxxxxxxxxxxx"

# ─── Configuración del Agente ─────────────────────────────────
# Zona horaria para el cron del reporte diario
AGENT_TIMEZONE="America/Bogota"
