# Copia este archivo a .env.local. Solo valores públicos: todo EXPO_PUBLIC_* queda dentro de la app.
# NUNCA pongas aquí la service role key ni contraseñas.
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<publishable-o-anon-key>
# Obligatorio: UUID de la sede cuyo menú se muestra y a la que llegan los pedidos
EXPO_PUBLIC_STORE_ID=<uuid-de-la-sede>
